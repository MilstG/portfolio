# Postgres. En Railway: Variables → Add Reference → DATABASE_URL del plugin Postgres.
# Vacío en local = Postgres embebido (PGLite, en memoria, se resetea al reiniciar).
DATABASE_URL=

# Opcional: true si el proxy público de Postgres exige SSL.
# PGSSL=true

# Minutos entre refrescos automáticos de precios. 0 los apaga.
# La pasada completa pega a CoinGecko, Yahoo, data912 y dolarapi.
# PRICE_REFRESH_MINUTES=60

# Minutos entre refrescos de SOLO crypto. 0 los apaga.
# Crypto opera 24/7 y se mueve mientras el resto de los mercados del libro
# están cerrados, así que se pregunta mucho más seguido. A propósito no
# arrastra a las otras fuentes: son endpoints gratuitos cotizando mercados
# cerrados, y pegarles sesenta veces por hora no trae precios más frescos,
# trae un rate limit.
# CRYPTO_REFRESH_MINUTES=1
