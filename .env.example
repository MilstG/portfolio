# ===========================================
# Railway Postgres connection string
# ===========================================
# When you create a Postgres database on Railway it gives you this URL.
# Copy it exactly into the Variable DATABASE_URL on your Railway service.
DATABASE_URL="postgresql://postgres:password@hostname:5432/railway"

# Optional (for later)
# COINGECKO_API_KEY=""
# NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"
