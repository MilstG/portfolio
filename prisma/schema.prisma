// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  CRYPTO
  STOCK
  BOND
  REAL_ESTATE
  CASH
  OTHER
}

enum Frequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  WEEKLY
  CUSTOM
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  BUY
  SELL
  DIVIDEND
  COUPON
  RENT
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  SCHEDULED
}

model Account {
  id           String   @id @default(cuid())
  name         String
  institution  String?
  type         String   @default("bank") // bank, broker, exchange, wallet, physical
  currency     String   @default("USD")
  balance      Decimal  @default(0) @db.Decimal(18, 4)
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
  assets       Asset[]

  @@map("accounts")
}

model Asset {
  id            String    @id @default(cuid())
  name          String
  ticker        String?
  type          AssetType
  quantity      Decimal?  @db.Decimal(18, 8)
  costBasis     Decimal   @default(0) @db.Decimal(18, 4)
  currency      String    @default("USD")
  currentPrice  Decimal?  @db.Decimal(18, 8)
  currentValue  Decimal?  @db.Decimal(18, 4)
  purchaseDate  DateTime?
  notes         String?
  isActive      Boolean   @default(true)
  accountId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account           Account?          @relation(fields: [accountId], references: [id])
  recurringIncomes  RecurringIncome[]
  transactions      Transaction[]
  priceHistory      PriceHistory[]

  @@map("assets")
}

model RecurringIncome {
  id          String    @id @default(cuid())
  assetId     String
  name        String
  amount      Decimal   @db.Decimal(18, 4)
  currency    String    @default("USD")
  frequency   Frequency @default(MONTHLY)
  nextDate    DateTime
  dayOfMonth  Int?
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("recurring_incomes")
}

model Transaction {
  id                 String            @id @default(cuid())
  date               DateTime
  description        String
  amount             Decimal           @db.Decimal(18, 4)
  currency           String            @default("USD")
  type               TransactionType
  category           String?
  status             TransactionStatus @default(COMPLETED)
  isRecurring        Boolean           @default(false)
  notes              String?
  assetId            String?
  accountId          String?
  recurringIncomeId  String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  asset            Asset?           @relation(fields: [assetId], references: [id])
  account          Account?         @relation(fields: [accountId], references: [id])
  recurringIncome  RecurringIncome? @relation(fields: [recurringIncomeId], references: [id])

  @@map("transactions")
}

model PriceHistory {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime
  price     Decimal  @db.Decimal(18, 8)
  source    String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@map("price_history")
}

model NetWorthSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique
  totalUsd  Decimal  @db.Decimal(18, 4)
  breakdown Json?
  createdAt DateTime @default(now())

  @@map("net_worth_snapshots")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  from      String
  to        String
  rate      Decimal  @db.Decimal(18, 8)
  date      DateTime @default(now())
  source    String?
  createdAt DateTime @default(now())

  @@unique([from, to, date])
  @@map("exchange_rates")
}
